# MedPulse Backend Environment Variables Template
PORT=8080
DATABASE_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require&connectTimeout=10&socketTimeout=30&tcpKeepAlive=true
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<YOUR_DATABASE_PASSWORD>
DDL_AUTO=none

JWT_SECRET=<YOUR_64_CHAR_HEX_OR_BASE64_JWT_SECRET>
JWT_EXPIRATION_MS=86400000

GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash

SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
